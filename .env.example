# Reference only — set these on the Cloudera AI Application, not in a local .env.
# The application runtime does not deploy .env from the repo.

IMPALA_HOST=your-impala-coordinator.example.com
IMPALA_PORT=443
IMPALA_USER=your-workload-user
IMPALA_PASSWORD=your-workload-password
IMPALA_DATABASE=default

# Optional Impala tuning
# IMPALA_AUTH_MECHANISM=LDAP
# IMPALA_USE_HTTP_TRANSPORT=true
# IMPALA_HTTP_PATH=cliservice
# IMPALA_USE_SSL=true

# Optional: require Authorization: Bearer <token> on /mcp
# MCP_BEARER_TOKEN=

# Do not set MCP_HOST / MCP_PORT / CDSW_APP_PORT on the application unless you
# know you need to — the platform sets CDSW_APP_PORT automatically.
